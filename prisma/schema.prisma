datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  idUser       String    @id @db.VarChar
  email        String?   @unique @db.VarChar
  passwordHash String?   @db.VarChar
  googleSub    String?   @unique @db.VarChar
  idRole       String?   @db.VarChar
  role         Role?     @relation(fields: [idRole], references: [idRole])
  karyawan     Karyawan? @relation(fields: [idUser], references: [idUser])
}

model Role {
  idRole          String           @id @db.VarChar
  namaRole        String?          @db.VarChar
  users           User[]
  rolePermissions RolePermission[]
}

model Permission {
  idPermission    String           @id @db.VarChar
  namaAction      String?          @db.VarChar
  rolePermissions RolePermission[]
}

model RolePermission {
  idRole       String     @db.VarChar
  idPermission String     @db.VarChar
  role         Role       @relation(fields: [idRole], references: [idRole])
  permission   Permission @relation(fields: [idPermission], references: [idPermission])

  @@id([idRole, idPermission])
}

model MasterGrade {
  idGrade   String     @id @db.VarChar
  namaGrade String?    @db.VarChar
  karyawan  Karyawan[]
}

model MasterDepartment {
  idDepartment   String     @id @db.VarChar
  namaDepartment String?    @db.VarChar
  urutan         Int?
  karyawan       Karyawan[]
}

model MasterStatus {
  idStatus        String            @id @db.VarChar
  namaStatus      String?           @db.VarChar
  kategoriModul   String?           @db.VarChar
  pengajuanCuti   PengajuanCuti[]
  kontrakKaryawan KontrakKaryawan[]
  talentProfiles  TalentProfile[]
  paymentRequests PaymentRequest[]
  assessments     Assessment[]
}

model MasterJenisCuti {
  idJenisCuti   String          @id @db.VarChar
  namaJenis     String?         @db.VarChar
  pengajuanCuti PengajuanCuti[]
}

model MasterKategoriPenyakit {
  idKategori   String      @id @db.VarChar
  namaKategori String?     @db.VarChar
  izinSakit    IzinSakit[]
}

model MasterKategoriPayment {
  idKategori      String           @id @db.VarChar
  namaKategori    String?          @db.VarChar
  paymentRequests PaymentRequest[]
}

model Karyawan {
  idKaryawan      String            @id @db.VarChar
  idUser          String?           @unique @db.VarChar
  nama            String?           @db.VarChar
  tanggalLahir    DateTime?         @db.Date
  tanggalMasuk    DateTime?         @db.Date
  idGrade         String?           @db.VarChar
  department      String?           @db.VarChar
  noTelepon       String?           @db.VarChar
  sisaCutiTahunan Int?              @default(12)
  accrualRate     Float?            @db.DoublePrecision
  tipeKontrak     String?           @default("KONTRAK") @db.VarChar
  user            User?             @relation
  masterGrade     MasterGrade?      @relation(fields: [idGrade], references: [idGrade])
  masterDepartment MasterDepartment? @relation(fields: [department], references: [idDepartment])
  pengajuanCuti   PengajuanCuti[]
  izinSakit       IzinSakit[]
  kontrakKaryawan KontrakKaryawan[]
  talentProfile   TalentProfile?
  paymentRequests PaymentRequest[]
  auditTrails     AuditTrail[]
  sertifikat      SertifikatKaryawan[]
  assessmentSubmissions AssessmentSubmission[]
  hrTodos         HrTodo[]
  notifications   Notification[]
}

model SertifikatKaryawan {
  idSertifikat String    @id @db.VarChar
  idKaryawan   String?   @db.VarChar
  judul        String?   @db.VarChar
  fileName     String?   @db.VarChar
  fileURL      String?   @db.VarChar
  karyawan     Karyawan? @relation(fields: [idKaryawan], references: [idKaryawan])
}

model PengajuanCuti {
  idCuti          String           @id @db.VarChar
  idKaryawan      String?          @db.VarChar
  tanggalMulai    DateTime?        @db.Timestamp()
  tanggalSelesai  DateTime?        @db.Timestamp()
  jumlahHari      Int?
  idJenisCuti     String?          @db.VarChar
  idStatus        String?          @db.VarChar
  tanggalPengajuan DateTime?       @db.Timestamp()
  disetujuiOleh   String?          @db.VarChar
  tanggalApproval DateTime?        @db.Timestamp()
  catatan         String?          @db.VarChar
  keterangan      String?          @db.VarChar
  karyawan        Karyawan?        @relation(fields: [idKaryawan], references: [idKaryawan])
  masterJenisCuti MasterJenisCuti? @relation(fields: [idJenisCuti], references: [idJenisCuti])
  masterStatus    MasterStatus?    @relation(fields: [idStatus], references: [idStatus])
}

model IzinSakit {
  idIzinSakit            String                  @id @db.VarChar
  idKaryawan             String?                 @db.VarChar
  tanggalMulai           DateTime?               @db.Timestamp()
  tanggalSelesai         DateTime?               @db.Timestamp()
  gejala                 String?                 @db.VarChar
  buktiSakitURL          String?                 @db.VarChar
  idKategoriPenyakit     String?                 @db.VarChar
  createdAt              DateTime                @default(now()) @db.Timestamp()
  karyawan               Karyawan?               @relation(fields: [idKaryawan], references: [idKaryawan])
  masterKategoriPenyakit MasterKategoriPenyakit? @relation(fields: [idKategoriPenyakit], references: [idKategori])
}

model KontrakKaryawan {
  idKontrak          String        @id @db.VarChar
  idKaryawan         String?       @db.VarChar
  tanggalMulai       DateTime?     @db.Date
  tanggalBerakhir    DateTime?     @db.Date
  idStatus           String?       @db.VarChar
  carryOver          Int?          @default(0)
  annualQuota        Int?          @default(12)
  dokumenAddendumURL String?       @db.VarChar
  addendumEmbedding  String?       @db.Text
  karyawan           Karyawan?     @relation(fields: [idKaryawan], references: [idKaryawan])
  masterStatus       MasterStatus? @relation(fields: [idStatus], references: [idStatus])
}

model TalentProfile {
  idTalent        String        @id @db.VarChar
  idKaryawan      String?       @unique @db.VarChar
  idStatusAsesmen String?       @db.VarChar
  fileCVURL       String?       @db.VarChar
  cvEmbedding     String?       @db.Text
  isIndexedAI     Boolean?
  karyawan        Karyawan?     @relation(fields: [idKaryawan], references: [idKaryawan])
  masterStatus    MasterStatus? @relation(fields: [idStatusAsesmen], references: [idStatus])
}

model PaymentRequest {
  idRequest                String                 @id @db.VarChar
  idKaryawan               String?                @db.VarChar
  projectID                String?                @db.VarChar
  nominal                  Float?                 @db.DoublePrecision
  idKategoriPayment        String?                @db.VarChar
  idStatus                 String?                @db.VarChar
  catatan                  String?                @db.VarChar
  detail                   String?                @db.Text
  createdAt                DateTime?              @default(now()) @db.Timestamp()
  tanggalPengajuan         DateTime?              @db.Timestamp()
  disetujuiOleh            String?                @db.VarChar
  tanggalApproval          DateTime?              @db.Timestamp()
  tanggalJadwalPembayaran  DateTime?              @db.Timestamp()
  tanggalLunas             DateTime?              @db.Timestamp()
  karyawan                 Karyawan?              @relation(fields: [idKaryawan], references: [idKaryawan])
  masterKategoriPayment    MasterKategoriPayment? @relation(fields: [idKategoriPayment], references: [idKategori])
  masterStatus             MasterStatus?          @relation(fields: [idStatus], references: [idStatus])
  attachments              PaymentAttachment[]
}

model PaymentAttachment {
  idAttachment String          @id @db.VarChar
  idRequest    String?         @db.VarChar
  fileName     String?         @db.VarChar
  fileURL      String?         @db.VarChar
  kategori     String?         @db.VarChar
  payment      PaymentRequest? @relation(fields: [idRequest], references: [idRequest])
}

model AuditTrail {
  idAudit     String    @id @db.VarChar
  idReferensi String?   @db.VarChar
  idKaryawan  String?   @db.VarChar
  idAktor     String?   @db.VarChar
  aktorNama   String?   @db.VarChar
  tindakan    String?   @db.VarChar
  // Array of { field, from, to } describing what changed in this action.
  perubahan   Json?
  waktu       DateTime? @db.Timestamp()
  karyawan    Karyawan? @relation(fields: [idKaryawan], references: [idKaryawan])
}

model LowonganKarir {
  idLowongan    String    @id @db.VarChar
  namaPosisi    String?   @db.VarChar
  deskripsi     String?   @db.VarChar
  idStatus      String?   @db.VarChar
  googleFormURL String?   @db.VarChar
  createdAt     DateTime? @default(now()) @db.Timestamp()
  updatedAt     DateTime? @updatedAt @db.Timestamp()
}

model Assessment {
  idAssessment String                 @id @db.VarChar
  judul        String?                @db.VarChar
  deskripsi    String?                @db.VarChar
  tanggalBuka  DateTime?              @db.Timestamp()
  tanggalTutup DateTime?              @db.Timestamp()
  idStatus     String?                @db.VarChar
  masterStatus MasterStatus?          @relation(fields: [idStatus], references: [idStatus])
  categories   AssessmentCategory[]
  submissions  AssessmentSubmission[]
}

model AssessmentCategory {
  idKategoriAsm String               @id @db.VarChar
  idAssessment  String?              @db.VarChar
  namaKategori  String?              @db.VarChar
  assessment    Assessment?          @relation(fields: [idAssessment], references: [idAssessment])
  questions     AssessmentQuestion[]
}

model AssessmentSubmission {
  idSubmission         String             @id @db.VarChar
  idKaryawan           String?            @db.VarChar
  idAssessment         String?            @db.VarChar
  tanggalSelesai       DateTime?          @db.Timestamp()
  technicalSkills      String?            @db.Text
  selfDevelopmentAreas String?            @db.Text
  karyawan             Karyawan?          @relation(fields: [idKaryawan], references: [idKaryawan])
  assessment           Assessment?        @relation(fields: [idAssessment], references: [idAssessment])
  answers              AssessmentAnswer[]
}

model AssessmentQuestion {
  idPertanyaan  String                     @id @db.VarChar
  idKategoriAsm String?                    @db.VarChar
  teks          String?                    @db.VarChar
  urutan        Int?
  // null = legacy fixed proficiency-level question (1-4). Otherwise: multiple_choice | checkbox | short_answer.
  tipeSoal      String?                    @db.VarChar
  kategori      AssessmentCategory?        @relation(fields: [idKategoriAsm], references: [idKategoriAsm])
  options       AssessmentQuestionOption[]
  answers       AssessmentAnswer[]
}

model AssessmentQuestionOption {
  idOpsi       String              @id @db.VarChar
  idPertanyaan String?             @db.VarChar
  teks         String?             @db.VarChar
  urutan       Int?
  pertanyaan   AssessmentQuestion? @relation(fields: [idPertanyaan], references: [idPertanyaan])
}

model AssessmentAnswer {
  idJawaban     String                @id @db.VarChar
  idSubmission  String?               @db.VarChar
  idPertanyaan  String?               @db.VarChar
  level         Int?
  // Selected option id(s) for multiple_choice (1 item) / checkbox (N items) questions.
  pilihan       Json?
  // Free text for short_answer questions.
  jawabanTeks   String?               @db.VarChar
  submission    AssessmentSubmission? @relation(fields: [idSubmission], references: [idSubmission])
  pertanyaan    AssessmentQuestion?   @relation(fields: [idPertanyaan], references: [idPertanyaan])
}

model HrTodo {
  idTodo     String    @id @db.VarChar
  idKaryawan String?   @db.VarChar
  teks       String?   @db.VarChar
  done       Boolean   @default(false)
  doneAt     DateTime? @db.Timestamp()
  createdAt  DateTime? @default(now()) @db.Timestamp()
  karyawan   Karyawan? @relation(fields: [idKaryawan], references: [idKaryawan])
}

model ApprovalHistory {
  idHistory    String   @id @db.VarChar
  idReferensi  String?  @db.VarChar
  modul        String?  @db.VarChar
  actorIdUser  String?  @db.VarChar
  action       String?  @db.VarChar
  catatan      String?  @db.VarChar
  createdAt    DateTime? @default(now()) @db.Timestamp()
}

model Notification {
  idNotif      String    @id @db.VarChar
  idKaryawan   String?   @db.VarChar
  tipe         String?   @db.VarChar
  judul        String?   @db.VarChar
  pesan        String?   @db.VarChar
  idReferensi  String?   @db.VarChar
  isRead       Boolean   @default(false)
  createdAt    DateTime? @default(now()) @db.Timestamp()
  karyawan     Karyawan? @relation(fields: [idKaryawan], references: [idKaryawan])
}

model TanggalBlokir {
  idBlokir     String    @id @db.VarChar
  tanggal      DateTime? @db.Date
  tanggalAkhir DateTime? @db.Date
  alasan       String?   @db.VarChar
  createdAt    DateTime? @default(now()) @db.Timestamp()
}
